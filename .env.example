# Скопируйте в .env и заполните. Файл .env никому не отправляйте.

# Пароль админки, минимум 12 символов. Сгенерировать: python3 -c "import secrets;print(secrets.token_urlsafe(18))"
ADMIN_PASSWORD=
# Секрет для cookie. Сгенерировать: python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Код доступа к форме. Рассылайте его вместе со ссылкой. Пусто = форма открыта всем, у кого есть ссылка.
ACCESS_CODE=

# Белый список телефонов: только эти номера смогут открыть форму. Через запятую, в любом формате
# (+7 701 234 56 78, 87012345678). Пусто = без ограничения.
ALLOWED_PHONES=

# Кто собирает данные (оператор персональных данных) — указывается в тексте согласия
ORGANIZER_NAME=[ФИО организатора, ИИН]
ORGANIZER_CONTACT=[телефон / WhatsApp организатора]
# Срок сбора, показывается в форме
DEADLINE=

# 1 — если сайт открыт по HTTPS (через Caddy или другой прокси)
COOKIE_SECURE=0
# 1 — если перед приложением стоит прокси (Caddy/nginx), чтобы в журнале были реальные IP
BEHIND_PROXY=0

MAX_FILE_MB=50
# Cloudflare (бесплатный план) режет запросы больше 100 МБ, поэтому не выше 95
MAX_TOTAL_MB=95

# Уведомления о новых анкетах на почту (только номер анкеты, сумма и число файлов, без ФИО/ИИН/документов).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=ваш@gmail.com,
# SMTP_PASSWORD=пароль приложения (Аккаунт Google → Безопасность → Пароли приложений). Пусто = не отправлять.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
# Адрес сайта для ссылки в письме
PUBLIC_URL=https://collect.igibaev.dev
